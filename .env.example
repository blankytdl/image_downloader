# Rename this file to .env and fill in real values.

# Required: get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# At least one image provider key is required.
# Pexels: https://www.pexels.com/api/  (free, generous limits)
PEXELS_API_KEY=

# Pixabay: https://pixabay.com/api/docs/  (free)
PIXABAY_API_KEY=

# Unsplash: https://unsplash.com/developers  (free, ~50 req/hour on demo tier)
UNSPLASH_ACCESS_KEY=

# Optional, OFF by default -- see README for licensing caveats.
# WARNING: as of 2026 the Custom Search JSON API is closed to new customers,
# and it shuts down for everyone on 2027-01-01. If you don't already have an
# existing key/project from before the closure, leave these unset and use
# SERPAPI_KEY below instead for the "google" category.
# Requires a Programmable Search Engine (https://programmablesearchengine.google.com/)
# configured with "Image search" turned on, plus a Custom Search JSON API key
# (https://developers.google.com/custom-search/v1/overview). Free tier: 100 queries/day.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# Optional, paid: real Google Images results via https://serpapi.com/
# (Microsoft's Bing Image Search API was retired in Aug 2025, so this is the
# practical way to get actual Google/web image results at volume.)
SERPAPI_KEY=

# Optional: GIF search. Giphy: https://developers.giphy.com/ (free)
GIPHY_API_KEY=

# DEAD -- Google fully shut down the Tenor API on 2026-06-30. This key is
# ignored by the bot even if set; kept only so old .env files don't break.
# Use GIPHY_API_KEY above for GIFs.
TENOR_API_KEY=

# Optional: sound-effects search. Freesound: https://freesound.org/apiv2/apply/
# (free -- simple API-key auth, no OAuth needed for text search + preview
# downloads). Results are restricted to CC0/Attribution licenses only.
FREESOUND_API_KEY=

# Safebooru, Danbooru (safe), Yande.re, Konachan, Waifu.im (anime art) and
# Openverse (Creative Commons photos) need no API key at all -- nothing to add.

# Which provider /search uses when the user doesn't specify one.
DEFAULT_PROVIDER=pexels

# Optional: process-wide cap on simultaneous file downloads across ALL jobs
# and chats at once (default 12). Lower this if your container has a small
# memory limit -- each download now streams to disk in small chunks rather
# than buffering the whole file in RAM, but a very small container may still
# want fewer of them running at the same instant.
GLOBAL_CONCURRENT_DOWNLOADS=12
